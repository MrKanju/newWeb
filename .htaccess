
RewriteOptions inherit
RewriteEngine On

# Redirect .html files to clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Clean URLs: Serve .html files without extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Redirect /index or /index.html → /
RewriteRule ^index\.html?$ / [R=301,L]

# Redirect /home → /
RewriteRule ^home/?$ / [R=301,L]

# Pretty URL for error page
RewriteRule ^404/?$ /error.html [L]

# Set default index file
DirectoryIndex index.html

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 year"
</IfModule>
RewriteCond %{HTTP_HOST} ^.*$
RewriteRule ^leads$ "https\:\/\/docs\.google\.com\/spreadsheets\/d\/1OxxG0laffWAS_YQ8fLjWfa6AxGDneFHH7nHsCcMrLM4\/edit\?pli\=1\&gid\=0\#gid\=0" [R=301,L]

# Custom Error Pages
ErrorDocument 404 /error.html
ErrorDocument 500 /error.html
ErrorDocument 403 /error.html

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php74” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74___lsphp .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# redirects for old php pages
# === Redirect old PHP pages ===
Redirect 301 /singlepage.php https://vismayakitchen.com/

# Remove query params and redirect properly
RewriteCond %{THE_REQUEST} \s/solutions\.php [NC]
RewriteRule ^solutions\.php$ https://vismayakitchen.com/service? [R=301,L]

RewriteCond %{THE_REQUEST} \s/solution-detail\.php [NC]
RewriteRule ^solution-detail\.php$ https://vismayakitchen.com/service? [R=301,L]

RewriteCond %{THE_REQUEST} \s/product-detail\.php [NC]
RewriteRule ^product-detail\.php$ https://vismayakitchen.com/service? [R=301,L]

RewriteCond %{THE_REQUEST} \s/about\.php [NC]
RewriteRule ^about\.php$ https://vismayakitchen.com/about? [R=301,L]

RewriteCond %{THE_REQUEST} \s/careers\.php [NC]
RewriteRule ^careers\.php$ https://vismayakitchen.com/contact? [R=301,L]
# === Pages you want to REMOVE completely ===
Redirect gone /finishes.php